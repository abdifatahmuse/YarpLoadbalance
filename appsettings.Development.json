{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "x-route": {
        "ClusterId": "x-cluster",
        "Match": {
          "Path": "x.com/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "{**catch-all}" }]
      },
      "lab-route": {
        "ClusterId": "lab-cluster",
        "Match": {
          "Path": "lab/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "{**catch-all}" }]
      }
    },
    "Clusters": {
      "x-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5051"
          },
          "destination2": {
            "Address": "http://220.20.0.0:5051"
          }
        }
      },
      "lab-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5075"
          },
          "destination2": {
            "Address": "http://10.20.0.0:5075"
          }
        }
      }
    }
  }
}
